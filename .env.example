# ===== Site público (prefixo PUBLIC_ = exposto no HTML) =====
# Tag de afiliado Amazon Associados Brasil (ex.: reviewprodutos-20). Obrigatório para ganhar comissão.
PUBLIC_AMAZON_TAG=reviewprodutos-20
# ID do editor AdSense (ex.: ca-pub-1234567890123456). Deixe vazio até ser aprovado.
PUBLIC_ADSENSE_CLIENT=
# Google Search Console (meta tag de verificação, só o conteúdo do atributo content)
PUBLIC_GSC_VERIFICATION=
# Google Analytics 4 (ex.: G-XXXXXXXXXX). Opcional.
PUBLIC_GA4_ID=G-55940SV53K

# ===== Gerador automático de artigos (GitHub Actions / local) =====
# Chave da API Anthropic (console.anthropic.com). Usada só no servidor/CI.
ANTHROPIC_API_KEY=
# Modelo do gerador (padrão: claude-opus-5-5; alternativa mais barata: claude-sonnet-5-5)
GENERATOR_MODEL=claude-opus-5-5
# Quantidade de artigos por lote (padrão: 5)
GENERATOR_BATCH_SIZE=5
