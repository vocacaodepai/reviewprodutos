---
/**
 * Capa dos comparativos: os 2 ou 3 produtos lado a lado, cada um com imagem (link direto, sem derivados),
 * selo, nota e botão de compra. Usada no topo do artigo (variant "capa") e no fim (variant "final").
 */
import Icon from './Icon.astro';
import ProductImage from './ProductImage.astro';
import { BADGES } from '@/site.config';
import { produtoUrl, formatNota, type Produto } from '@/lib/articles';
interface Props { produtos: Produto[]; destaqueAsin?: string; titulo?: string; variant?: 'capa' | 'final'; }
const { produtos, destaqueAsin, titulo, variant = 'capa' } = Astro.props;
const cols = produtos.length >= 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
const eager = variant === 'capa';
---
<section class="not-prose card overflow-hidden p-4 sm:p-5" aria-label={titulo ?? 'Os produtos comparados'}>
  {titulo && <p class="mb-3 text-center text-xs font-bold uppercase tracking-wider muted">{titulo}</p>}
  <div class={`grid gap-4 ${cols}`}>
    {produtos.map((p, i) => {
      const selo = p.selo ? BADGES[p.selo] : null;
      const url = produtoUrl(p);
      const destaque = p.asin === destaqueAsin;
      return (
        <div class={`relative flex flex-col rounded-2xl border p-3 text-center ${destaque ? 'border-2 border-star-400/70 bg-star-400/5' : 'border-soft'}`}>
          {i > 0 && <span class="absolute -left-3 top-1/3 z-10 hidden h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full bg-[var(--fg)] text-[10px] font-extrabold uppercase text-[var(--bg)] sm:flex" aria-hidden="true">vs</span>}
          <a href={url} rel="sponsored nofollow noopener" target="_blank" class="block rounded-xl bg-white p-2" data-asin={p.asin} data-track="affiliate-click" aria-label={`Ver ${p.nome} na Amazon`}>
            <ProductImage src={p.imagem.src} alt={p.imagem.alt} width={p.imagem.largura} height={p.imagem.altura} class="mx-auto h-40 w-full object-contain sm:h-48" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager && i === 0 ? 'high' : 'auto'} />
          </a>
          <div class="mt-3 flex min-h-[1.5rem] justify-center">{selo && <span class={`badge ${selo.color}`}>{selo.label}</span>}</div>
          <p class="mt-2 font-bold leading-snug">{p.nome}</p>
          <p class="mt-1 text-xs muted">Nota {formatNota(p.nota)}/10</p>
          <a href={url} rel="sponsored nofollow noopener" target="_blank" class="btn-buy mt-auto w-full pt-0 text-sm" data-asin={p.asin} data-track="affiliate-click"><Icon name="cart" size={16} /> Comprar agora na Amazon</a>
        </div>
      );
    })}
  </div>
</section>
