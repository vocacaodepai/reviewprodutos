---
/** Veredito rápido (resumo em 30 segundos) com os destaques (selos). */
import Icon from './Icon.astro';
import ProductImage from './ProductImage.astro';
import { BADGES } from '@/site.config';
import { slugify, formatNota, type Produto } from '@/lib/articles';
interface Props { veredito: string; produtos: Produto[]; tipo: 'review' | 'comparativo' | 'lista'; }
const { veredito, produtos, tipo } = Astro.props;
const destaques = produtos.filter((p) => p.selo).slice(0, 4);
const picks = destaques.length ? destaques : produtos.slice(0, Math.min(3, produtos.length));
---
<section class="card overflow-hidden" aria-labelledby="veredito">
  <div class="border-b border-soft bg-gradient-to-r from-brand-800 to-brand-600 px-5 py-3 text-white sm:px-6">
    <h2 id="veredito" class="flex items-center gap-2 text-base font-bold"><Icon name="sparkles" size={18} /> Resumo em 30 segundos</h2>
  </div>
  <div class="p-5 sm:p-6">
    <p class="text-[1.05rem] leading-relaxed">{veredito}</p>
    {tipo !== 'review' && picks.length > 0 && (
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map((p, i) => (
          <li>
            <a href={`#produto-${slugify(p.nome)}`} class="flex items-center gap-3 rounded-xl border border-soft p-3 transition hover:bg-soft">
              <ProductImage src={p.imagem.src} alt={p.imagem.alt} class="h-16 w-16 shrink-0 rounded-lg bg-white object-contain p-1" width={128} height={128} />
              <span class="min-w-0">
                <span class={`badge ${p.selo ? BADGES[p.selo]?.color : 'bg-soft border border-soft'}`}>{p.selo ? BADGES[p.selo]?.label : `#${i + 1}`}</span>
                <span class="mt-1 block truncate text-sm font-semibold">{p.nome}</span>
                <span class="text-xs muted">Nota {formatNota(p.nota)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
