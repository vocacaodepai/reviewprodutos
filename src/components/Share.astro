---
import Icon from './Icon.astro';
interface Props { url: string; title: string; }
const { url, title } = Astro.props;
const enc = encodeURIComponent;
---
<div class="flex flex-wrap items-center gap-2 text-sm">
  <span class="muted inline-flex items-center gap-1"><Icon name="share" size={16} /> Compartilhar:</span>
  <a class="btn-ghost h-9 px-3 text-xs" href={`https://api.whatsapp.com/send?text=${enc(title + ' ' + url)}`} target="_blank" rel="noopener nofollow">WhatsApp</a>
  <a class="btn-ghost h-9 px-3 text-xs" href={`https://t.me/share/url?url=${enc(url)}&text=${enc(title)}`} target="_blank" rel="noopener nofollow">Telegram</a>
  <a class="btn-ghost h-9 px-3 text-xs" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`} target="_blank" rel="noopener nofollow">Facebook</a>
  <a class="btn-ghost h-9 px-3 text-xs" href={`https://x.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`} target="_blank" rel="noopener nofollow">X</a>
  <button type="button" class="btn-ghost h-9 px-3 text-xs" data-copy={url}>Copiar link</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Link copiado!'; } catch { b.textContent = 'Copie a URL do navegador'; }
  }));
</script>
