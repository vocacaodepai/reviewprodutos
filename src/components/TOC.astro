---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; extras?: { slug: string; text: string }[]; }
const { headings, extras = [] } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---
{(items.length + extras.length) > 1 && (
  <nav class="card p-5 text-sm" aria-label="Neste artigo">
    <p class="mb-3 text-xs font-bold uppercase tracking-wider muted">Neste artigo</p>
    <ol class="space-y-2">
      {items.map((h) => <li><a href={`#${h.slug}`} class="block leading-snug hover:text-brand-600 hover:underline">{h.text}</a></li>)}
      {extras.map((e) => <li><a href={`#${e.slug}`} class="block leading-snug hover:text-brand-600 hover:underline">{e.text}</a></li>)}
    </ol>
  </nav>
)}
