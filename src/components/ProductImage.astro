---
/**
 * Imagem de produto (remota, CDN Amazon/fabricante). Otimizada no build via astro:assets.
 * Defina IMAGES_PASSTHROUGH=true para servir a URL original sem processar (builds de emergência).
 */
import { Image } from 'astro:assets';
interface Props { src: string; alt: string; width?: number; height?: number; class?: string; sizes?: string; loading?: 'lazy' | 'eager'; fetchpriority?: 'high' | 'low' | 'auto'; }
const { src, alt, width, height, class: className = '', sizes, loading = 'lazy', fetchpriority = 'auto', ...rest } = Astro.props as Props & Record<string, unknown>;
// Imagens da Amazon são exibidas por link direto, sem download/cache/derivados (Contrato do Programa de Associados BR).
const isAmazon = /(^|\.)(media-amazon\.com|ssl-images-amazon\.com|images-amazon\.com)$/i.test(new URL(src).hostname);
const passthrough = isAmazon || import.meta.env.IMAGES_PASSTHROUGH === 'true';
const w = width ?? 800;
---
{passthrough ? (
  <img src={src} alt={alt} class={className} loading={loading} decoding="async" fetchpriority={fetchpriority} width={width} height={height} referrerpolicy="no-referrer" {...rest} />
) : width && height ? (
  <Image src={src} alt={alt} width={width} height={height} class={className} loading={loading} decoding="async" fetchpriority={fetchpriority} sizes={sizes} quality={78} format="webp" {...rest} />
) : (
  <Image src={src} alt={alt} inferSize width={w} class={className} loading={loading} decoding="async" fetchpriority={fetchpriority} sizes={sizes} quality={78} format="webp" {...rest} />
)}
