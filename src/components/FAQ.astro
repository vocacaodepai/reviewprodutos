---
interface Props { itens: { pergunta: string; resposta: string }[]; titulo?: string; }
const { itens, titulo = 'Perguntas frequentes' } = Astro.props;
---
<section class="not-prose my-10" aria-labelledby="faq">
  <h2 id="faq" class="mb-4 text-2xl font-bold">{titulo}</h2>
  <div class="divide-y divide-[var(--border)] rounded-2xl border border-soft">
    {itens.map((f, i) => (
      <details class="group px-5 py-4" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold [&::-webkit-details-marker]:hidden">
          <span>{f.pergunta}</span>
          <span class="shrink-0 text-brand-500 transition group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-[0.98rem] leading-relaxed muted">{f.resposta}</p>
      </details>
    ))}
  </div>
</section>
