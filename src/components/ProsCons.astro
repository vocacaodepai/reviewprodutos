---
import Icon from './Icon.astro';
interface Props { pros: string[]; contras: string[]; compact?: boolean; }
const { pros, contras, compact = false } = Astro.props;
---
<div class={`grid gap-4 ${compact ? '' : 'sm:grid-cols-2'}`}>
  <div class="rounded-xl border border-check-200 bg-check-50/60 p-4 dark:border-check-900 dark:bg-check-900/20">
    <h4 class="mb-2 flex items-center gap-2 text-sm font-bold text-check-800 dark:text-check-300"><Icon name="thumbs-up" size={16} /> Prós</h4>
    <ul class="space-y-1.5 text-sm">
      {pros.map((p) => <li class="flex gap-2"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-check-600" />{p}</li>)}
    </ul>
  </div>
  <div class="rounded-xl border border-danger-500/30 bg-danger-500/5 p-4">
    <h4 class="mb-2 flex items-center gap-2 text-sm font-bold text-danger-600"><Icon name="thumbs-down" size={16} /> Contras</h4>
    <ul class="space-y-1.5 text-sm">
      {contras.map((c) => <li class="flex gap-2"><Icon name="minus" size={16} class="mt-0.5 shrink-0 text-danger-500" />{c}</li>)}
    </ul>
  </div>
</div>
