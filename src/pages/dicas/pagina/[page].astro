---
import ListingPage from '@/components/ListingPage.astro';
import { getArtigos, paginate, PER_PAGE } from '@/lib/articles';
import { ARTICLE_TYPES } from '@/site.config';
export async function getStaticPaths() {
  const all = await getArtigos((a) => a.data.tipo === 'guia');
  const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
const t = ARTICLE_TYPES['guia'];
const all = await getArtigos((a) => a.data.tipo === 'guia');
const pg = paginate(all, page, PER_PAGE);
---
<ListingPage title={t.labelPlural} description={`${t.description} Página ${page}.`} base={`/dicas/`} page={pg.current} totalPages={pg.totalPages} items={pg.items} total={pg.total} crumbs={[{ name: t.labelPlural, url: `/dicas/` }, { name: `Página ${page}` }]} />
