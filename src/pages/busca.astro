---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCategorias } from '@/lib/articles';
const categorias = await getCategorias();
---
<BaseLayout title="Buscar reviews e produtos" description="Busque reviews, comparativos e listas dos melhores produtos por nome, marca, categoria ou problema que você quer resolver." noindex>
  <div class="container-site py-8">
    <Breadcrumbs items={[{ name: 'Busca' }]} />
    <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">Buscar</h1>
    <p class="mt-2 muted">Digite o nome do produto, a marca ou o problema que você quer resolver. Use os filtros para refinar por categoria e tipo de artigo.</p>
    <div id="search" class="mt-6"></div>
    <noscript><p class="mt-6 rounded-xl border border-soft p-4">A busca precisa de JavaScript. Enquanto isso, navegue pelas categorias:</p></noscript>
    <div class="mt-10">
      <h2 class="text-sm font-bold uppercase tracking-wider muted">Ou navegue por categoria</h2>
      <div class="mt-3 flex flex-wrap gap-2">{categorias.map((c) => <a href={`/categoria/${c.id}/`} class="chip">{c.data.nome}</a>)}</div>
    </div>
  </div>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" slot="head" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(location.search);
      const q = params.get('q') || '';
      if (!window.PagefindUI) {
        document.getElementById('search').innerHTML = '<p class="rounded-xl border border-soft p-4">O índice de busca é gerado no build de produção (npm run build). Em desenvolvimento, use a navegação por categorias.</p>';
        return;
      }
      new window.PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: true,
        excerptLength: 30,
        pageSize: 10,
        resetStyles: false,
        sort: { data: 'desc' },
        translations: {
          placeholder: 'Buscar produto, marca ou problema…',
          clear_search: 'Limpar',
          load_more: 'Carregar mais resultados',
          search_label: 'Buscar no site',
          filters_label: 'Filtros',
          zero_results: 'Nenhum resultado para [SEARCH_TERM]',
          many_results: '[COUNT] resultados para [SEARCH_TERM]',
          one_result: '[COUNT] resultado para [SEARCH_TERM]',
          alt_search: 'Sem resultados para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM]',
          search_suggestion: 'Sem resultados para [SEARCH_TERM]. Tente uma destas buscas:',
          searching: 'Buscando [SEARCH_TERM]…',
        },
        processResult: (r) => { if (r.meta && r.meta.image) { r.meta.image = r.meta.image; } return r; },
      });
      if (q) {
        const input = document.querySelector('#search input');
        if (input) { input.value = q; input.dispatchEvent(new Event('input', { bubbles: true })); }
      }
    });
  </script>
</BaseLayout>
