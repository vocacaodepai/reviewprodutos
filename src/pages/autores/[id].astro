---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getArtigos } from '@/lib/articles';
import { graph, organizationSchema, personSchema } from '@/lib/schema';
export async function getStaticPaths() {
  const autores = await getCollection('autores');
  return autores.map((autor) => ({ params: { id: autor.id }, props: { autor } }));
}
const { autor } = Astro.props;
const artigos = (await getArtigos((a) => a.data.autor.id === autor.id)).slice(0, 24);
---
<BaseLayout title={`${autor.data.nome} — ${autor.data.cargo}`} description={autor.data.bioCurta} jsonLd={graph([organizationSchema(), personSchema(autor)])}>
  <div class="container-site py-8">
    <Breadcrumbs items={[{ name: 'Autores' }, { name: autor.data.nome }]} />
    <header class="card mt-4 flex flex-col gap-5 p-6 sm:flex-row sm:items-start">
      <img src={autor.data.avatar} alt={`Foto de ${autor.data.nome}`} width="128" height="128" class="h-32 w-32 rounded-full border-4 border-white bg-soft object-cover shadow-lg ring-4 ring-brand-500" />
      <div>
        <h1 class="text-3xl font-extrabold">{autor.data.nome}</h1>
        <p class="muted">{autor.data.cargo}</p>
        <p class="mt-3 max-w-3xl leading-relaxed">{autor.data.bio}</p>
        {autor.data.especialidades.length > 0 && <p class="mt-3 flex flex-wrap gap-1">{autor.data.especialidades.map((e) => <span class="chip text-xs">{e}</span>)}</p>}
      </div>
    </header>
    <h2 class="mt-10 mb-4 text-2xl font-bold">Artigos de {autor.data.nome}</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{artigos.map((a) => <ArticleCard artigo={a} />)}</div>
  </div>
</BaseLayout>
