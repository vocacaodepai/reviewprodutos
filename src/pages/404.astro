---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getArtigos } from '@/lib/articles';
const recentes = (await getArtigos()).slice(0, 3);
---
<BaseLayout title="Página não encontrada" description="A página que você procura não existe ou foi movida." noindex>
  <div class="container-site py-16 text-center">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-3 text-3xl font-bold">Essa página não existe (ou mudou de lugar)</h1>
    <p class="mt-3 muted">Tente buscar o produto ou volte para a página inicial.</p>
    <form action="/busca/" method="get" class="mx-auto mt-6 flex max-w-md gap-2"><input name="q" type="search" placeholder="Buscar produto…" class="flex-1 rounded-xl border border-soft px-4 py-2.5" /><button class="btn-primary">Buscar</button></form>
    <a href="/" class="btn-ghost mt-4">Ir para a página inicial</a>
    {recentes.length > 0 && <div class="mt-12 grid gap-6 text-left sm:grid-cols-3">{recentes.map((a) => <ArticleCard artigo={a} />)}</div>}
  </div>
</BaseLayout>
